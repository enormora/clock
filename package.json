{
    "name": "@enormora/clock",
    "version": "0.0.1",
    "type": "module",
    "description": "Explicit time and timer access for TypeScript applications",
    "main": "target/build/source/index.js",
    "types": "target/build/source/index.d.ts",
    "exports": {
        ".": {
            "types": "./target/build/source/index.d.ts",
            "import": "./target/build/source/index.js"
        },
        "./clock": {
            "types": "./target/build/source/clock.d.ts",
            "import": "./target/build/source/clock.js"
        },
        "./deterministic-clock": {
            "types": "./target/build/source/deterministic-clock.d.ts",
            "import": "./target/build/source/deterministic-clock.js"
        },
        "./temporal-clock": {
            "types": "./target/build/source/temporal-clock.d.ts",
            "import": "./target/build/source/temporal-clock.js"
        }
    },
    "files": [
        "target/build/source/",
        "!target/build/source/**/*.test.js",
        "!target/build/source/**/*.d.ts.map",
        "!target/build/source/**/*.map"
    ],
    "keywords": [
        "clock",
        "deterministic",
        "isomorphic",
        "test",
        "time",
        "timer",
        "typescript",
        "clock"
    ],
    "author": "Christian Rackerseder <git@echooff.de>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/enormora/clock.git"
    },
    "devDependencies": {
        "@enormora/eslint-config-base": "0.0.61",
        "@enormora/eslint-config-mocha-node-assert": "0.0.16",
        "@enormora/eslint-config-node": "0.0.46",
        "@enormora/eslint-config-typescript": "0.0.69",
        "@packtory/cli": "0.0.112",
        "@types/mocha": "10.0.10",
        "@types/node": "24.13.5",
        "c8": "12.0.0",
        "eslint": "10.9.0",
        "mocha": "12.0.1",
        "rust-just": "1.57.0",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": "^24.15.0 || ^26.0.0"
    }
}
